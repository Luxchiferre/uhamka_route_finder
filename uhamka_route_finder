runApp(const UhamkaRouteApp());
}
class UhamkaRouteApp extends StatelessWidget {
const UhamkaRouteApp({super.key});
@override
Widget build(BuildContext context) {
return MaterialApp(
title: 'UHAMKA AI Route',
