columns: const [
DataColumn(label: Text("Algoritma")),
DataColumn(label: Text("Jalur (Path)")),
DataColumn(label: Text("Cost")),
],
rows: results.map((r) => DataRow(cells: [
DataCell(Text(r['alg'], style: const TextStyle(fontWeight: FontWeight.bold))),
DataCell(Text((r['data']['path'] as List).join(" → "))),
DataCell(Text(r['data']['cost'].toString())),
])).toList(),
),
